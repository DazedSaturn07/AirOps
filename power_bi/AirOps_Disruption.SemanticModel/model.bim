          },
          {
            "name": "Arrived Flights",
            "displayFolder": "Operations",
            "expression": [
              "CALCULATE(",
              "    [Flights],",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(NOT ISBLANK(fact_flight[arrival_delay_minutes]))",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "11cfd3e0-cae3-43a6-a4dc-9263a8f1728c"
          },
          {
            "name": "On-Time Arrivals",
            "displayFolder": "Arrival performance",
            "expression": [
              "CALCULATE(",
              "    [Flights],",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(NOT ISBLANK(fact_flight[arrival_delay_minutes])),",
              "    KEEPFILTERS(fact_flight[arrival_delay_minutes] <= 15)",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "6bc1a98b-3ae8-4eba-8656-877a92882d49"
          },
          {
            "name": "Delay >15 Flights",
            "displayFolder": "Arrival performance",
            "expression": [
              "CALCULATE(",
              "    [Flights],",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(fact_flight[arrival_delay_minutes] > 15)",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "2fb0f86e-a690-43e6-8deb-494c09e72840"
          },
          {
            "name": "Severe Delay Flights",
            "displayFolder": "Arrival performance",
            "expression": [
              "CALCULATE(",
              "    [Flights],",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(fact_flight[arrival_delay_minutes] > 60)",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "5baefe46-663c-4ec1-ab97-5dde4d08fa6a"
          },
          {
            "name": "On-Time Arrival %",
            "displayFolder": "Arrival performance",
            "expression": "DIVIDE([On-Time Arrivals], [Arrived Flights])",
            "formatString": "0.00%",
            "lineageTag": "52cab213-06fa-477b-b781-195f2b9384f3"
          },
          {
            "name": "Delay >15 %",
            "displayFolder": "Arrival performance",
            "expression": "DIVIDE([Delay >15 Flights], [Arrived Flights])",
            "formatString": "0.00%",
            "lineageTag": "6340885c-c607-4959-91c4-64f684d65104"
          },
          {
            "name": "Severe Delay %",
            "displayFolder": "Arrival performance",
            "expression": "DIVIDE([Severe Delay Flights], [Arrived Flights])",
            "formatString": "0.00%",
            "lineageTag": "08a510fd-233c-40d5-ae10-ba3301a69a64"
          },
          {
            "name": "Cancellation %",
            "displayFolder": "Operations",
            "expression": "DIVIDE([Cancelled Flights], [Flights])",
            "formatString": "0.00%",
            "lineageTag": "e53710a9-1d21-4884-a877-806dfc2c389a"
          },
          {
            "name": "Diversion %",
            "displayFolder": "Operations",
            "expression": "DIVIDE([Diverted Flights], [Flights])",
            "formatString": "0.00%",
            "lineageTag": "11a7c0a3-6bc1-48dc-8b20-ae6389bc54f4"
          },
          {
            "name": "Arrival Delay Minutes",
            "displayFolder": "Arrival performance",
            "expression": [
              "COALESCE(CALCULATE(",
              "    SUM(fact_flight[arrival_delay_minutes]),",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(NOT ISBLANK(fact_flight[arrival_delay_minutes]))",
              "), 0)"
            ],
            "formatString": "#,##0",
            "lineageTag": "56727b4f-c4cd-4cb7-90cb-b3a00bb5c5c9"
          },
          {
            "name": "Average Arrival Delay Minutes",
            "displayFolder": "Arrival performance",
            "expression": "DIVIDE([Arrival Delay Minutes], [Arrived Flights])",
            "formatString": "0.00",
            "lineageTag": "fcd68dde-07f5-4e67-9e2e-8cf65b27e807"
          },
          {
            "name": "Median Arrival Delay Minutes",
            "displayFolder": "Arrival performance",
            "expression": [
              "CALCULATE(",
              "    MEDIAN(fact_flight[arrival_delay_minutes]),",
              "    KEEPFILTERS(fact_flight[cancelled] = 0),",
              "    KEEPFILTERS(fact_flight[diverted] = 0),",
              "    KEEPFILTERS(NOT ISBLANK(fact_flight[arrival_delay_minutes]))",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "b73bdbca-c660-4863-899e-8082e4b24f0e"
          },
          {
            "name": "Route Reliability Index",
            "displayFolder": "Operations",
            "expression": [
              "IF(",
              "    [Flights] > 0 && [Arrived Flights] > 0,",
              "    MAX(0, 100 - 50 * [Delay >15 %] - 50 * [Cancellation %]),",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0",
            "lineageTag": "605ada9f-580d-455e-8eaa-448373c82d27"
          },
          {
            "name": "Air System Minutes",
            "displayFolder": "Operations",
            "expression": "SUM(fact_flight[air_system_delay_minutes])",
            "formatString": "#,##0",
            "lineageTag": "6303103a-cb53-4795-b276-187aa9fb20be"
          },
          {
            "name": "Security Minutes",
            "displayFolder": "Operations",
            "expression": "SUM(fact_flight[security_delay_minutes])",
            "formatString": "#,##0",
            "lineageTag": "6ac9c8e3-1356-4891-9454-ce9d86582fc8"
          },
          {
            "name": "Airline Minutes",
            "displayFolder": "Operations",
            "expression": "SUM(fact_flight[airline_delay_minutes])",
            "formatString": "#,##0",
            "lineageTag": "a5c17ed2-2acf-4cd5-ba3d-c03d6c4e52d0"
          },
          {
            "name": "Late Aircraft Minutes",
            "displayFolder": "Operations",
            "expression": "SUM(fact_flight[late_aircraft_delay_minutes])",
            "formatString": "#,##0",
            "lineageTag": "1a9d4b4d-6b8b-4669-9cec-c3b2866e537a"
          },
          {
            "name": "Weather Minutes",
            "displayFolder": "Operations",
            "expression": "SUM(fact_flight[weather_delay_minutes])",
            "formatString": "#,##0",
            "lineageTag": "7f5ba888-17e2-4e18-890a-15fda1ce4ac3"
          },
          {
            "name": "Recorded Cause Minutes",
            "displayFolder": "Operations",
            "expression": [
              "[Air System Minutes] + [Security Minutes] + [Airline Minutes] +",
              "[Late Aircraft Minutes] + [Weather Minutes]"
            ],
            "formatString": "#,##0",
            "lineageTag": "0a4ed89b-b54c-484d-87b6-65d65ff07317"
          },
          {
            "name": "Cause Minutes",
            "displayFolder": "Operations",
            "expression": [
              "SWITCH(",
              "    SELECTEDVALUE(DelayCause[Cause]),",
              "    \"Air system\", [Air System Minutes],",
              "    \"Security\", [Security Minutes],",
              "    \"Airline\", [Airline Minutes],",
              "    \"Late aircraft\", [Late Aircraft Minutes],",
              "    \"Weather\", [Weather Minutes]",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "e52a5c0c-4c0f-4b8e-96e3-7991f1a3fced"
          },
          {
            "name": "Cause Share %",
            "displayFolder": "Operations",
            "expression": "DIVIDE([Cause Minutes], [Recorded Cause Minutes])",
            "formatString": "0.00%",
            "lineageTag": "9afa86db-f6d8-4788-b162-6384cb1978d0"
          },
          {
            "name": "Numeric Airport Rows",
            "displayFolder": "Report context",
            "expression": "CALCULATE([Flights], KEEPFILTERS(fact_flight[Airport code type] = \"Numeric ID\"))",
            "formatString": "#,##0",
            "lineageTag": "8c2c92ef-cd71-40b6-8428-eb735aa1a126"
          },
          {
            "name": "Numeric Airport %",
            "displayFolder": "Report context",
            "expression": "DIVIDE([Numeric Airport Rows], [Flights])",
            "formatString": "0.00%",
            "lineageTag": "862c95cb-5faa-49dd-aa0c-ba1436c65901"
          },
          {
            "name": "Late Aircraft Share %",
            "displayFolder": "Report context",
            "expression": "DIVIDE([Late Aircraft Minutes], [Recorded Cause Minutes])",
            "formatString": "0.00%",
            "lineageTag": "d708c92a-fe23-4137-8e68-beb7ce395b21"
          },
          {
            "name": "Route Late Rank",
            "displayFolder": "Report context",
            "expression": "IF([Flights] >= 1000 && [Arrived Flights] > 0, RANKX(FILTER(ALLSELECTED(fact_flight[route_code]), CALCULATE([Flights]) >= 1000 && CALCULATE([Arrived Flights]) > 0), [Delay >15 %],, DESC, Dense))",
            "formatString": "0",
            "lineageTag": "5e3cfe77-280f-4b8d-a184-62c6f00d7532"
          },
          {
            "name": "Origin Severe Rank",
            "displayFolder": "Report context",
            "expression": "IF([Flights] >= 1000 && [Arrived Flights] > 0, RANKX(FILTER(ALLSELECTED(fact_flight[origin_airport_code]), CALCULATE([Flights]) >= 1000 && CALCULATE([Arrived Flights]) > 0), [Severe Delay %],, DESC, Dense))",
            "formatString": "0",
            "lineageTag": "2772c3c0-e99c-416c-ba9a-ed84084b9e8a"
          },
          {
            "name": "Route Context",
            "displayFolder": "Report context",
            "expression": "SELECTEDVALUE(fact_flight[route_code], \"All source-code routes\")",
            "lineageTag": "bf97ec37-2c49-44b7-bce1-7fd09d377428"
          }
        ],
        "partitions": [
          {
            "name": "fact_flight",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(ProjectFolder & \"/notebooks/data/processed/fact_flight.parquet\")),",
                "    Selected = Table.RemoveColumns(Source, {\"flight_key\", \"candidate_operational_key\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"flight_date\", type date}, {\"source_row_number\", Int64.Type}, {\"cancelled\", Int64.Type}, {\"diverted\", Int64.Type}, {\"departure_hour\", Int64.Type}, {\"peak_period\", Int64.Type}}),",
                "    Coverage = Table.AddColumn(Typed, \"Airport code type\", each if Text.Length([origin_airport_code]) = 3 then \"IATA\" else \"Numeric ID\", type text),",
                "    Period = Table.AddColumn(Coverage, \"Departure period\", each if [peak_period] = 1 then \"Peak (06-09 / 16-19)\" else \"Other scheduled hours\", type text)",
                "in",
                "    Period"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Airline",
        "columns": [
          {
            "name": "airline_code",
            "dataType": "string",
            "isKey": true,
            "lineageTag": "4620e9ae-bf3f-4f24-a0a3-b6e69eeec348",
            "sourceColumn": "airline_code",
            "summarizeBy": "none"
          },
          {
            "name": "airline_name",
            "dataType": "string",
            "lineageTag": "b2699636-b078-4d39-ad1c-e6cdad328358",
            "sourceColumn": "airline_name",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "115520ed-87bf-4cb5-9322-080f7eb9c415",
        "partitions": [
          {
            "name": "Airline",
            "mode": "import",
            "source": {
              "expression": [
                "let Source = Csv.Document(File.Contents(ProjectFolder & \"/notebooks/data/raw/airlines.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "Renamed = Table.RenameColumns(Headers,{{\"IATA_CODE\",\"airline_code\"},{\"AIRLINE\",\"airline_name\"}})",
                "in Table.TransformColumnTypes(Renamed,{{\"airline_code\",type text},{\"airline_name\",type text}})"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "Date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-mm-dd",
            "isKey": true,
            "lineageTag": "1ac03631-eba9-48f6-a68f-d7b4d70b4603",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "lineageTag": "1e30419f-a58e-4632-8cd0-1cac56906137",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "MonthNumber",
            "dataType": "int64",
            "lineageTag": "73dacc4d-f66c-4a19-bf90-8b2b836d5255",
            "sourceColumn": "MonthNumber",
            "summarizeBy": "none"
          },
          {
            "name": "YearMonth",
            "dataType": "string",
            "lineageTag": "4a5745b0-d9bf-4005-8ba1-de46f9101e7e",
            "sortByColumn": "MonthNumber",
            "sourceColumn": "YearMonth",
            "summarizeBy": "none"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "cf295281-5f46-45e7-8b21-bd339795b920",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let Dates = Table.FromList(List.Dates(#date(2015,1,1),365,#duration(1,0,0,0)),Splitter.SplitByNothing(),{\"Date\"}),",
                "Typed = Table.TransformColumnTypes(Dates,{{\"Date\",type date}}),",
                "Year = Table.AddColumn(Typed,\"Year\",each Date.Year([Date]),Int64.Type),",
                "Month = Table.AddColumn(Year,\"MonthNumber\",each Date.Month([Date]),Int64.Type),",
                "Label = Table.AddColumn(Month,\"YearMonth\",each Date.ToText([Date],\"yyyy-MM\"),type text)",
                "in Label"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "DelayCause",
        "columns": [
          {
            "name": "Cause",
            "dataType": "string",
            "lineageTag": "b7ef8919-7cf7-48ac-8105-b44aac16664c",
            "sourceColumn": "Cause",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "fd2c2a74-f2de-4d01-b508-bafeef76499c",
        "partitions": [
          {
            "name": "DelayCause",
            "mode": "import",
            "source": {
              "expression": "#table(type table [Cause=text],{{\"Air system\"},{\"Security\"},{\"Airline\"},{\"Late aircraft\"},{\"Weather\"}})",
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}
